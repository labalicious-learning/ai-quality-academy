{
  "name": "ai-quality-academy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node sandbox/server.mjs",
    "test": "node --test sandbox/*.test.mjs scripts/aiqaa-decision.test.mjs scripts/path.test.mjs scripts/review.test.mjs scripts/signup.test.mjs scripts/today.test.mjs examples/shift-garden/core.test.mjs",
    "example": "node scripts/serve-example.mjs",
    "test:path": "node --test scripts/path.test.mjs",
    "check:path": "node scripts/check-site.mjs --path-only",
    "test:assessment": "node --test scripts/aiqaa-decision.test.mjs",
    "verify": "node scripts/verify.mjs",
    "check:labs": "node scripts/check-labs.mjs",
    "test:handouts": "node --test scripts/handouts.test.mjs",
    "build": "node --test scripts/handouts.test.mjs && node scripts/build-site.mjs",
    "build:full": "node --test scripts/handouts.test.mjs && node scripts/build-site.mjs --exports",
    "slides:html": "marp --input-dir decks --output dist/slides --theme-set theme/academy.css --theme academy",
    "slides:pdf": "marp --input-dir decks --pdf --output dist/pdf --theme-set theme/academy.css --theme academy",
    "slides:pptx": "marp --input-dir decks --pptx --output dist/pptx --theme-set theme/academy.css --theme academy"
  },
  "devDependencies": {
    "@marp-team/marp-cli": "4.5.1",
    "markdown-it": "14.3.1"
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.12",
    "puppeteer-core": "25.10.0"
  }
}
